# Copy this file to .env for local development.
# Do not commit secrets or a populated .env file.

APP_ENV=development
LOG_LEVEL=INFO
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
FEATURE_DATA_DIR=data/features
MONITORING_OUTPUT_DIR=data/monitoring
MONITORING_METRICS_STATE_PATH=data/monitoring/metrics.json
TELCO_DELTA_PATH=data/processed/telco_customer_churn_delta
DBT_DUCKDB_PATH=data/features/churn_analytics.duckdb
MLFLOW_TRACKING_URI=sqlite:///data/mlflow/mlflow.db
MLFLOW_EXPERIMENT_NAME=telco-customer-churn
MLFLOW_REGISTERED_MODEL_NAME=telco-churn-classifier
MODEL_MIN_TEST_ROC_AUC=0.80
MODEL_MIN_TEST_F1=0.60
MODEL_MIN_TEST_RECALL=0.70
MODEL_MIN_ROC_AUC_IMPROVEMENT=0.001
MODEL_MAX_F1_REGRESSION=0.02
MODEL_MAX_RECALL_REGRESSION=0.02
TELCO_RAW_PATH=data/raw/telco_customer_churn.csv
AIRFLOW_HOME=data/airflow
AIRFLOW__CORE__DAGS_FOLDER=orchestration/dags
AIRFLOW__CORE__LOAD_EXAMPLES=false
CHURN_DAG_SCHEDULE=
CHURN_PIPELINE_USE_SYNTHETIC_DATA=true

# Docker Compose development configuration. Change all example secrets outside
# a local demo environment.
CHURN_REPOSITORY_ROOT=/opt/mlops
AIRFLOW_PORT=8080
MLFLOW_PORT=5000
METRICS_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana-dev-only
MLOPS_UID=50000
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow-dev-only
POSTGRES_DB=airflow
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_FERNET_KEY=DvcNv1G2YNg03QsJ4Nw2Yj54OibzpkT9G0L5T6h5XE4=
AIRFLOW_API_SECRET_KEY=airflow-api-dev-only-change-me
