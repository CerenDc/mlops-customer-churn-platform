{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Quality Check",
      "type": "shell",
      "command": "ruff check . && ruff format --check . && pytest -q",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "echo": true,
        "focus": false,
        "panel": "shared",
        "reveal": "always"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "dbt Build",
      "type": "shell",
      "command": "dbt build --project-dir dbt_project --profiles-dir dbt_project",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "echo": true,
        "focus": false,
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "Train Models",
      "type": "shell",
      "command": "python -m churn_platform.ml.train",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "echo": true,
        "focus": false,
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "Model Registry",
      "type": "shell",
      "command": "python -m churn_platform.ml.registry",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "echo": true,
        "focus": false,
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "Airflow Standalone",
      "type": "shell",
      "command": "airflow standalone",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}",
          "AIRFLOW_HOME": "${workspaceFolder}/data/airflow",
          "AIRFLOW__CORE__DAGS_FOLDER": "${workspaceFolder}/orchestration/dags",
          "AIRFLOW__CORE__LOAD_EXAMPLES": "false"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "echo": true,
        "focus": false,
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Airflow DAG Test",
      "type": "shell",
      "command": "airflow dags test mlops_customer_churn_pipeline --dagfile-path \"${workspaceFolder}/orchestration/dags/churn_mlops_pipeline.py\"",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}",
          "AIRFLOW_HOME": "${workspaceFolder}/data/airflow",
          "AIRFLOW__CORE__DAGS_FOLDER": "${workspaceFolder}/orchestration/dags",
          "AIRFLOW__CORE__LOAD_EXAMPLES": "false"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "echo": true,
        "focus": false,
        "panel": "dedicated",
        "reveal": "always"
      }
    }
  ]
}
